{
  "_comment": "PickupCard 默认主题（三段式）。shadowAlpha=0 是刻意的：阴影 quad 目前会把顶点 alpha 丢掉、整块渲染成不透明黑，根因未定位前不用它。详见 docs/plan-ui.md 的\"阴影未解\"一节。",
  "geometry": {
    "cornerRadius": 6,
    "paddingH": 6,
    "paddingV": 4,
    "gap": 4,
    "iconScale": 1.5,
    "barWidth": 5
  },
  "material": {
    "fillTop": "#262B38D1",
    "fillBottom": "#161A22DB",
    "border": "#FFFFFF2E",
    "highlight": "#FFFFFF3C",
    "shadowAlpha": 0,
    "shadowOffsetY": 3,
    "shadowBlur": 6,
    "glowAlpha": 46
  },
  "text": {
    "nameColor": "#EBEFF6F0"
  },
  "animation": {
    "enterMs": 620,
    "bumpMs": 300,
    "enterEnabled": true,
    "bumpEnabled": true,
    "glowPulseEnabled": true
  }
}
