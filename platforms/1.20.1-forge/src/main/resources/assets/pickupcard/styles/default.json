{
  "_comment": "PickupCard 默认主题（三段式）。纯几何/材质参数，改完一秒内生效；资源包同路径可整体覆盖。颜色写法 #RRGGBBAA。",
  "geometry": {
    "cornerRadius": 6,
    "paddingH": 6,
    "paddingV": 4,
    "gap": 4,
    "iconScale": 1.5,
    "barWidth": 5
  },
  "material": {
    "fillTop": "#262B38D1",
    "fillBottom": "#161A22DB",
    "border": "#FFFFFF2E",
    "highlight": "#FFFFFF3C",
    "shadowAlpha": 90,
    "shadowOffsetY": 3,
    "shadowBlur": 6,
    "glowAlpha": 46
  },
  "text": {
    "nameColor": "#EBEFF6F0"
  },
  "animation": {
    "enterMs": 620,
    "bumpMs": 300,
    "enterEnabled": true,
    "bumpEnabled": true,
    "glowPulseEnabled": true
  }
}
